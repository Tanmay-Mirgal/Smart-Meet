# Meetup — environment variables.
# Copy to .env.local and fill in the values. Never commit real secrets.

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin for SEO, sitemap, invite links and emails.
# Leave blank in local dev (falls back to http://localhost:3000); set in production.
NEXT_PUBLIC_APP_URL=https://meetup.tanmaymirgal.dev
APP_BASE_URL=https://meetup.tanmaymirgal.dev

# ── Clerk (auth + organizations) ─────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# Set in the Convex dashboard too (convex/auth.config.ts reads it)
CLERK_JWT_ISSUER_DOMAIN=

# ── Convex ───────────────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ── Transcription & AI ───────────────────────────────────────────────────────
# NVIDIA Riva ASR (Parakeet multilingual). Key from https://build.nvidia.com
NVIDIA_API_KEY=
# auto   = NVIDIA for Hindi / English, Groq Whisper for Marathi modes (default)
# nvidia = NVIDIA first for every mode, Groq as fallback
# groq   = Groq Whisper only
TRANSCRIPTION_PROVIDER=auto
# Optional NVIDIA tuning:
# NVIDIA_ASR_TIMEOUT_MS=8000
# NVIDIA_ASR_FUNCTION_ID=71203149-d3b7-4460-8231-1be2543a1fca
# NVIDIA_ASR_LANGUAGE_CODE=            # force one language code, e.g. hi-IN or multi
# Self-hosted Speech NIM instead of the hosted catalog (use one of these):
# NVIDIA_ASR_HTTP_URL=http://localhost:9000
# NVIDIA_ASR_SERVER=localhost:50051
# NVIDIA_ASR_USE_SSL=false

# Groq: Whisper fallback + AI summaries.
# Also set GROQ_API_KEY in the Convex dashboard if you enable the ecosystem connector:
# its server-side summaries (meetings.generateSummary) run inside Convex.
GROQ_API_KEY=
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# ── Billing (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Integrations ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=primary
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://meetup.tanmaymirgal.dev/api/integrations/notion/callback

# ── Invitation + minutes email (SMTP) ────────────────────────────────────────
INVITATION_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── Ecosystem connector (CP1) — lets a central "Hub" schedule/end meetings, read ──
# transcripts/summaries/tasks and receive signed webhooks. See docs/CONNECTOR.md.
# The whole feature is OFF unless CONNECTOR_ENABLED=true. The connector code runs
# inside Convex, so set EVERY CONNECTOR_* value (and NEXT_PUBLIC_APP_URL /
# APP_BASE_URL) in the Convex dashboard as well as here. Rewrites are read at
# build/start time, so rebuild/restart Next.js after changing the flag.
CONNECTOR_ENABLED=false
# Shown on the consent screen: "<name> wants to connect to your Meetup account".
CONNECTOR_HUB_NAME=
# The Hub is one pre-registered confidential OAuth client.
CONNECTOR_HUB_CLIENT_ID=
CONNECTOR_HUB_CLIENT_SECRET=
# Comma separated, exact match only. https required (http://localhost only with CONNECTOR_DEV_MODE).
CONNECTOR_HUB_REDIRECT_URIS=
# >= 32 random chars. Tokens are stored only as HMAC-SHA256(pepper, token).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CONNECTOR_TOKEN_PEPPER=
# 64 hex chars (AES-256-GCM key for webhook secrets).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_ENCRYPTION_KEY=
# Optional: rotate by adding CONNECTOR_ENCRYPTION_KEY_V2 (new data uses the highest key id).
# Server-side summary fallback when the host closes the tab before a summary exists:
CONNECTOR_AUTO_SUMMARY=false
CONNECTOR_AUTO_SUMMARY_DELAY_MINUTES=10
# Local development only: allow http://localhost redirect URIs and loopback webhook targets.
# CONNECTOR_DEV_MODE=false
# Optional override for the docs link advertised in the manifest.
# CONNECTOR_DOCS_URL=

# ── WebRTC (optional: add a TURN server for restrictive networks) ────────────
# NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
# NEXT_PUBLIC_TURN_URL=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_PASSWORD=
